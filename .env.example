# Copy this file to .env. Never commit real secrets.
DATABASE_URL=postgres://snorlaxden:snorlaxden_dev@127.0.0.1:5432/snorlaxden
POSTGRES_DB=snorlaxden
POSTGRES_USER=snorlaxden
POSTGRES_PASSWORD=snorlaxden_dev
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# AI writing studio. Keep disabled until server-side keys and administrator access are configured.
AI_TEXT_ENABLED=false
AI_DAILY_LIMIT=20
PUBLIC_AI_ENABLED=false
PUBLIC_AI_DAILY_LIMIT=10
CONTENT_ARTICLE_DIR=content/articles
CONTENT_EXPORT_DIR=content/exports
# Private source materials. Keep local until every COS field is configured and the official adapter is enabled.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.private-files
COS_BUCKET=digital-1486267453
COS_REGION=ap-guangzhou
COS_SECRET_ID=
COS_SECRET_KEY=
# Public garden export reads only the explicit whitelist. Keep a private Vault outside this repository.
PUBLIC_GARDEN_SOURCE_DIR=
PUBLIC_GARDEN_MANIFEST=
PUBLIC_GARDEN_OUTPUT_DIR=content/public-garden
# Random salt used to hash client IP addresses in audit logs. Never commit the real value.
AUDIT_IP_HASH_SALT=
AI_IMAGE_ENABLED=false
AI_IMAGE_PROVIDER=sophnet
AI_IMAGE_BASE_URL=https://www.sophnet.com/api/open-apis/projects/easyllms/imagegenerator
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=Doubao-Seedream-5.0-pro
AI_IMAGE_DOWNLOAD_HOSTS=ark-acg-cn-beijing.tos-cn-beijing.volces.com
AI_IMAGE_DAILY_LIMIT=8
AI_VIDEO_CARD_ENABLED=false
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/v1
STEPFUN_MODEL=step-3.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
